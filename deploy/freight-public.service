[Unit]
Description=Freight public dashboard and read-only API
Wants=network-online.target
After=network-online.target docker.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=freight-public
Group=freight-public
WorkingDirectory=/opt/freight-public/current
EnvironmentFile=/etc/freight-public/api.env
ExecStart=/opt/freight-public/runtime/node-v24.22.2-linux-x64/bin/node dist/api/server/index.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
MemoryMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target
