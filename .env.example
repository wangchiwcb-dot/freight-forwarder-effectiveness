# Development demo: choose explicitly. Production defaults to postgres.
DATA_SOURCE=demo
HOST=127.0.0.1
PORT=3001
SOURCE_TENANT=szzhhq
# For an existing PostgreSQL 15+ database with migrations 001–008 applied:
# DATA_SOURCE=postgres
# DATABASE_URL=postgresql://freight_public_api:REPLACE_ME@127.0.0.1:5432/freight_times
# DB_SSL=verify-full
DB_POOL_MAX=5
# Production: npm run build, then set STATIC_DIR=dist/client and NODE_ENV=production.
# Demo is rejected in production unless ALLOW_PRODUCTION_DEMO=true is explicit.
# STATIC_DIR=dist/client
RATE_LIMIT_MAX=120
# Only enable with a local reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=none
