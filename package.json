{
  "name": "zhhq-transit-insights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prepare-sites-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "format": "prettier --write scripts/capture-design.mjs src tests/e2e docs *.md *.json *.ts *.mjs index.html",
    "format:check": "prettier --check scripts/capture-design.mjs src tests/e2e docs *.md *.json *.ts *.mjs index.html",
    "capture": "node scripts/capture-design.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@fontsource/dm-sans": "^5.3.0",
    "antd": "^5.29.0",
    "dayjs": "^1.11.13",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
