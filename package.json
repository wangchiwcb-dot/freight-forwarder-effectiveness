{
  "name": "zhhq-transit-insights",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:api",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "format": "prettier --write src server shared tests/e2e docs scripts/capture-design.mjs scripts/package-release.mjs *.md *.json *.ts *.mjs index.html .github/workflows/*.yml",
    "format:check": "prettier --check src server shared tests/e2e docs scripts/capture-design.mjs scripts/package-release.mjs *.md *.json *.ts *.mjs index.html .github/workflows/*.yml",
    "capture": "node scripts/capture-design.mjs",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "start": "node --env-file-if-exists=.env dist/api/server/index.js",
    "build:client": "tsc --noEmit && vite build && node scripts/prepare-sites-build.mjs",
    "build:api": "tsc -p server/tsconfig.json",
    "package": "npm run build && node scripts/package-release.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:sites && npm run test:e2e"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fontsource/dm-sans": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "antd": "^5.29.0",
    "dayjs": "^1.11.13",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "6.4.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
